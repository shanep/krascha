{
  "name": "krascha",
  "version": "0.1.0",
  "private": true,
  "description": "Krascha reads how you talk to Claude Code, Copilot CLI, and Antigravity and decides who the machines hunt first.",
  "license": "MIT",
  "author": "Shane K. Panter",
  "homepage": "https://krascha.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanep/krascha.git"
  },
  "type": "module",
  "bin": {
    "krascha": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "node scripts/build.mjs",
    "site": "node scripts/dev-site.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run -s typecheck && npm test && npm run -s build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
